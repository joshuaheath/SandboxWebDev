@{
    List<string> pokemons = ["pikachu", "charizard", "eevee", "bulbasaur", "lucario", "lapras", "mew"];
    int i = 0;
// C: \Users\gamef\School RelatedNonOne Drive\Sem 2\WebAppProg\SandboxWebDev\wwwroot\images\
}


<div class="text-center">
    <h1 class="display-4">POKEMON</h1>
</div>

@foreach (string pokemon in pokemons)
{
    String tempFile = "../images/" + pokemon + ".png";
    <div class="text-center">
        <p>Pokemon @i: @pokemon</p>
        <img src=@tempFile alt="A picture of @pokemon" />
    </div>

    i += 1;
}